{
  "name": "common",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js"
    },
    "./constants": {
      "types": "./lib/constants/index.d.ts",
      "import": "./lib/constants/index.js"
    },
    "./localization": {
      "types": "./lib/localization/index.d.ts",
      "import": "./lib/localization/index.js"
    },
    "./logger": {
      "types": "./lib/logger/index.d.ts",
      "import": "./lib/logger/index.js"
    },
    "./models": {
      "types": "./lib/models/index.d.ts",
      "import": "./lib/models/index.js"
    },
    "./privileges": {
      "types": "./lib/privileges/index.d.ts",
      "import": "./lib/privileges/index.js"
    },
    "./types": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./validations": {
      "types": "./lib/validations/index.d.ts",
      "import": "./lib/validations/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo ./lib",
    "dev": "tsc -w",
    "test": "NODE_OPTIONS=--experimental-vm-modules yarn exec jest"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.33.2",
    "@influxdata/influxdb-client-apis": "^1.33.2",
    "argon2": "^0.28.7",
    "date-fns": "^2.30.0",
    "dotenv": "^18.0.4",
    "hat": "^0.0.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.13.22",
    "node-dotify": "^1.1.0",
    "node-fetch": "^2.7.0",
    "purify-ts": "^2.1.4",
    "ramda": "^0.27.1",
    "rate-limiter-flexible": "^2.4.2",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/hat": "^0.0.1",
    "@types/jest": "^26.0.24",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^26.6.3",
    "@types/node-fetch": "^2.6.11",
    "@types/ramda": "0.27.34",
    "@types/react": "^18.2.79",
    "@types/supertest": "^6",
    "jest": "~29.0.0",
    "jest-util": "^29.0.0",
    "mongodb-memory-server": "^7.6.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}