{
    "extends": "../../tsconfig-base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": "./",
        "outDir": "dist",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "sourceMap": true,
        "moduleResolution": "node",
        "allowJs": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "module": "ESNext",
        "jsx": "react"
        // "allowSyntheticDefaultImports": true,
        // "noFallthroughCasesInSwitch": true,
        // "strict": true
    },
    "paths": {
        "common": [
            "../common/lib"
        ],
        "common/*": [
            "../common/lib/*"
        ],
    },
    "include": [
        "src",
        "custom.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}