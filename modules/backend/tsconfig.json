{
    "extends": "../../tsconfig-base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "target": "ES2022"
    },
    "references": [
        {
            "path": "../common"
        }
    ],
    "include": [
        "./src"
    ],
    "exclude": [
        "./dist",
        "src/**/*.spec.ts",
        "__tests__"
    ]
}